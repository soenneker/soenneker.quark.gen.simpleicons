<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591;</NoWarn>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddBuildTasksOutputToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Build-time source generation for Simple Icons icons in Quark and Razor projects</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Quark.Gen.SimpleIcons</AssemblyName>
        <PackageId>Soenneker.Quark.Gen.SimpleIcons</PackageId>
        <PackageTags>quark gen simpleicons simple icons icon externalgenerator csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.quark.gen.simpleicons</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.quark.gen.simpleicons</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Soenneker.Quark.Gen.SimpleIcons.targets" Pack="true" PackagePath="build/" />
        <None Include="Soenneker.Quark.Gen.SimpleIcons.targets" Pack="true" PackagePath="buildTransitive/" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(TargetDir)$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Quark.Gen.SimpleIcons.Abstractions" Version="4.0.19" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    </ItemGroup>
    <PropertyGroup>
        <SimpleIconsNativeRuntimeIdentifier Condition="'$(SimpleIconsNativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</SimpleIconsNativeRuntimeIdentifier>
        <SimpleIconsNativeArtifactsDir Condition="'$(SimpleIconsNativeArtifactsDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../artifacts/native'))</SimpleIconsNativeArtifactsDir>
        <_SimpleIconsNativeExecutable>Soenneker.Quark.Gen.SimpleIcons.BuildTasks</_SimpleIconsNativeExecutable>
        <_SimpleIconsNativeExecutable Condition="$([System.String]::Copy('$(SimpleIconsNativeRuntimeIdentifier)').StartsWith('win-'))">$(_SimpleIconsNativeExecutable).exe</_SimpleIconsNativeExecutable>
    </PropertyGroup>

    <Target Name="BuildBuildTasksTool" BeforeTargets="Build"
            Condition="'$(SimpleIconsUsePrebuiltNativeTools)' != 'true'"
            Inputs="@(SimpleIconsNativeSource);../Soenneker.Quark.Gen.SimpleIcons.BuildTasks/obj/project.assets.json"
            Outputs="$(SimpleIconsNativeArtifactsDir)/$(SimpleIconsNativeRuntimeIdentifier)/$(_SimpleIconsNativeExecutable)">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Soenneker.Quark.Gen.SimpleIcons.BuildTasks/Soenneker.Quark.Gen.SimpleIcons.BuildTasks.csproj&quot; --configuration Release --runtime $(SimpleIconsNativeRuntimeIdentifier) --output &quot;$(SimpleIconsNativeArtifactsDir)/$(SimpleIconsNativeRuntimeIdentifier)&quot;" />
    </Target>

    <ItemGroup>
        <SimpleIconsNativeSource Include="../Soenneker.Quark.Gen.SimpleIcons.BuildTasks/**/*.cs;../Soenneker.Quark.Gen.SimpleIcons.BuildTasks/*.csproj"
                             Exclude="../Soenneker.Quark.Gen.SimpleIcons.BuildTasks/bin/**;../Soenneker.Quark.Gen.SimpleIcons.BuildTasks/obj/**" />
    </ItemGroup>

    <Target Name="AddBuildTasksOutputToPackage" DependsOnTargets="BuildBuildTasksTool">
        <ItemGroup>
            <_SimpleIconsRequiredRuntime Include="win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64" Condition="'$(SimpleIconsUsePrebuiltNativeTools)' == 'true'" />
            <_SimpleIconsNativeFile Include="$(SimpleIconsNativeArtifactsDir)/**/*"
                                Exclude="$(SimpleIconsNativeArtifactsDir)/**/*.pdb;$(SimpleIconsNativeArtifactsDir)/**/*.dbg;$(SimpleIconsNativeArtifactsDir)/**/*.dSYM/**" />
            <TfmSpecificPackageFile Include="@(_SimpleIconsNativeFile)" PackagePath="tools/native/" />
        </ItemGroup>
        <Error Condition="'@(_SimpleIconsRequiredRuntime)' != '' and !Exists('$(SimpleIconsNativeArtifactsDir)/%(_SimpleIconsRequiredRuntime.Identity)/Soenneker.Quark.Gen.SimpleIcons.BuildTasks') and !Exists('$(SimpleIconsNativeArtifactsDir)/%(_SimpleIconsRequiredRuntime.Identity)/Soenneker.Quark.Gen.SimpleIcons.BuildTasks.exe')"
               Text="Missing native simpleicons tool for %(_SimpleIconsRequiredRuntime.Identity)." />
        <Error Condition="'@(_SimpleIconsNativeFile)' == ''" Text="Native simpleicons tools are missing. Publish BuildTasks before packing." />
    </Target>
</Project>
