<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Target Name="SimpleIconsGeneratorBuild_Imported" BeforeTargets="Build">
        <Message Importance="high" Text="Soenneker.Quark.Gen.SimpleIcons targets imported from: $(MSBuildThisFileFullPath)" />
    </Target>

    <PropertyGroup>
        <!-- Select the SDK host rather than the application's RuntimeIdentifier (for example browser-wasm). -->
        <SimpleIconsToolRuntimeIdentifier Condition="'$(SimpleIconsToolRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</SimpleIconsToolRuntimeIdentifier>
        <_SimpleIconsExecutableName>Soenneker.Quark.Gen.SimpleIcons.BuildTasks</_SimpleIconsExecutableName>
        <_SimpleIconsExecutableName Condition="$([System.String]::Copy('$(SimpleIconsToolRuntimeIdentifier)').StartsWith('win-'))">$(_SimpleIconsExecutableName).exe</_SimpleIconsExecutableName>
        <_SimpleIconsNativePackagePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/native/$(SimpleIconsToolRuntimeIdentifier)/$(_SimpleIconsExecutableName)'))</_SimpleIconsNativePackagePath>
        <_SimpleIconsNativeProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts/native/$(SimpleIconsToolRuntimeIdentifier)/$(_SimpleIconsExecutableName)'))</_SimpleIconsNativeProjectPath>
        <SimpleIconsBuildTasksExecutablePath Condition="'$(SimpleIconsBuildTasksExecutablePath)' == '' and Exists('$(_SimpleIconsNativePackagePath)')">$(_SimpleIconsNativePackagePath)</SimpleIconsBuildTasksExecutablePath>
        <SimpleIconsBuildTasksExecutablePath Condition="'$(SimpleIconsBuildTasksExecutablePath)' == ''">$(_SimpleIconsNativeProjectPath)</SimpleIconsBuildTasksExecutablePath>

        <_SimpleIconsTargetsPath>$(MSBuildThisFileFullPath)</_SimpleIconsTargetsPath>
        <SimpleIconsGeneratorBuildEnabled Condition="'$(SimpleIconsGeneratorBuildEnabled)'==''">true</SimpleIconsGeneratorBuildEnabled>
        <SimpleIconsIncludeSvgProvider Condition="'$(SimpleIconsIncludeSvgProvider)'==''">true</SimpleIconsIncludeSvgProvider>
        <SimpleIconsIncludeServiceCollectionExtensions Condition="'$(SimpleIconsIncludeServiceCollectionExtensions)'==''">true</SimpleIconsIncludeServiceCollectionExtensions>
        <_SimpleIconsProjectDir>$([System.IO.Path]::GetDirectoryName('$(ProjectDir)x'))</_SimpleIconsProjectDir>
        <_SimpleIconsProjectDir Condition="'$(_SimpleIconsProjectDir)' == ''">$(MSBuildProjectDirectory)</_SimpleIconsProjectDir>
    </PropertyGroup>

    <ItemGroup>
        <_SimpleIconsGeneratorInputs Include="$(_SimpleIconsProjectDir)\**\*.cs;$(_SimpleIconsProjectDir)\**\*.razor"
                                     Exclude="$(_SimpleIconsProjectDir)\bin\**;$(_SimpleIconsProjectDir)\obj\**;$(_SimpleIconsProjectDir)\node_modules\**" />
    </ItemGroup>

    <Target Name="ResolveSimpleIconsResources" BeforeTargets="ResolveSimpleIconsBuildTasksPath" Condition="'$(DesignTimeBuild)'!='true'">
        <ItemGroup>
            <_SimpleIconsPkgRef Include="@(PackageReference)" Condition="'%(Identity)' == 'Soenneker.SimpleIcons.Icons'" />
        </ItemGroup>
        <PropertyGroup>
            <_SimpleIconsVersion>@(_SimpleIconsPkgRef->'%(Version)')</_SimpleIconsVersion>
            <_SimpleIconsPackagesRoot Condition="'$(RestorePackagesPath)' != ''">$(RestorePackagesPath)</_SimpleIconsPackagesRoot>
            <_SimpleIconsPackagesRoot Condition="'$(_SimpleIconsPackagesRoot)' == '' and '$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)</_SimpleIconsPackagesRoot>
            <_SimpleIconsPackageResources Condition="'$(_SimpleIconsPackagesRoot)' != '' and '$(_SimpleIconsVersion)' != ''">$([System.IO.Path]::Combine('$(_SimpleIconsPackagesRoot)', 'soenneker.simpleicons.icons', '$(_SimpleIconsVersion)', 'contentFiles', 'any', 'any', 'Resources', 'SimpleIcons'))</_SimpleIconsPackageResources>
            <_SimpleIconsResourcesOutputDir>$([System.IO.Path]::Combine('$(IntermediateOutputPath)', 'SimpleIconsResources'))</_SimpleIconsResourcesOutputDir>
        </PropertyGroup>
    </Target>

    <Target Name="ResolveSimpleIconsBuildTasksPath" BeforeTargets="RunSimpleIconsGeneratorBuildTasks;IncludeGeneratedSimpleIconsSources;IncludeGeneratedSimpleIconsSourcesDesignTime">
        <PropertyGroup>
            <SimpleIconsSvgMapOutput Condition="'$(SimpleIconsSvgMapOutput)' == ''">$([System.IO.Path]::Combine('$(IntermediateOutputPath)', 'Generated', 'SimpleIconSvgMap.g.cs'))</SimpleIconsSvgMapOutput>
            <SimpleIconsSvgProviderOutput Condition="'$(SimpleIconsSvgProviderOutput)' == ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(SimpleIconsSvgMapOutput)')), 'SimpleIconSvgProvider.g.cs'))</SimpleIconsSvgProviderOutput>
            <SimpleIconsServiceCollectionExtensionsOutput Condition="'$(SimpleIconsServiceCollectionExtensionsOutput)' == ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(SimpleIconsSvgMapOutput)')), 'SimpleIconServiceCollectionExtensions.g.cs'))</SimpleIconsServiceCollectionExtensionsOutput>
            <_SimpleIconsOutputArg> --output &quot;$(SimpleIconsSvgMapOutput)&quot;</_SimpleIconsOutputArg>
            <_SimpleIconsResourcesArg Condition="'$(SimpleIconsResourcesPath)' != ''"> --resourcesPath &quot;$(SimpleIconsResourcesPath)&quot;</_SimpleIconsResourcesArg>
            <_SimpleIconsResourcesArg Condition="'$(_SimpleIconsResourcesArg)' == '' and Exists('$(_SimpleIconsPackageResources)')"> --resourcesPath &quot;$(_SimpleIconsPackageResources)&quot;</_SimpleIconsResourcesArg>
            <_SimpleIconsResourcesArg Condition="'$(_SimpleIconsResourcesArg)' == ''"> --resourcesPath &quot;$([System.IO.Path]::Combine('$(IntermediateOutputPath)', 'SimpleIconsResources'))&quot;</_SimpleIconsResourcesArg>
        </PropertyGroup>
    </Target>


    <Target Name="PrepareSimpleIconsGeneratorInputs" DependsOnTargets="ResolveSimpleIconsBuildTasksPath"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true' and '$(SimpleIconsGeneratorBuildEnabled)'=='true'">
        <PropertyGroup>
            <_SimpleIconsInputManifest>$(IntermediateOutputPath)simpleicons-generator.inputs</_SimpleIconsInputManifest>
            <_SimpleIconsSuccessStamp>$(IntermediateOutputPath)simpleicons-generator.stamp</_SimpleIconsSuccessStamp>
            <_SimpleIconsResourceRoot>$(_SimpleIconsPackageResources)</_SimpleIconsResourceRoot>
            <_SimpleIconsResourceRoot Condition="'$(_SimpleIconsResourceRoot)'==''">$(IntermediateOutputPath)SimpleIconsResources</_SimpleIconsResourceRoot>
            <_SimpleIconsResourceRoot Condition="'$(SimpleIconsResourcesPath)'!=''">$(SimpleIconsResourcesPath)</_SimpleIconsResourceRoot>
        </PropertyGroup>
        <ItemGroup>
            <_SimpleIconsTrackedInputs Include="@(_SimpleIconsGeneratorInputs);$(_SimpleIconsResourceRoot)/*.svg;$(_SimpleIconsTargetsPath);$(MSBuildProjectFullPath);$(MSBuildAllProjects);$(ProjectAssetsFile);$(SimpleIconsBuildTasksExecutablePath)" />
        </ItemGroup>
        <MakeDir Directories="$(IntermediateOutputPath)" />
        <WriteLinesToFile File="$(_SimpleIconsInputManifest)"
                          Lines="@(_SimpleIconsTrackedInputs->'%(FullPath)|%(ModifiedTime)');$(_SimpleIconsOutputArg);$(_SimpleIconsResourcesArg)"
                          Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Delete Files="$(_SimpleIconsSuccessStamp)" Condition="!Exists('$(SimpleIconsSvgMapOutput)') or !Exists('$(SimpleIconsSvgProviderOutput)') or !Exists('$(SimpleIconsServiceCollectionExtensionsOutput)')" />
    </Target>

    <Target Name="RunSimpleIconsGeneratorBuildTasks"
            DependsOnTargets="PrepareSimpleIconsGeneratorInputs"
            BeforeTargets="XamlPreCompile;BeforeCompile;CoreCompile"
            Inputs="$(_SimpleIconsInputManifest)"
            Outputs="$(_SimpleIconsSuccessStamp)"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true' and '$(SimpleIconsGeneratorBuildEnabled)'=='true'">

        <Message Importance="high" Text="Running Soenneker.Quark.Gen.SimpleIcons BuildTasks: projectDir=$(_SimpleIconsProjectDir)" />
        <Error Condition="'$(_SimpleIconsProjectDir)' == ''"
               Text="Soenneker.Quark.Gen.SimpleIcons: project directory could not be resolved. Set SimpleIconsProjectDir or build a project that has a valid project directory." />
        <Error Condition="'$(SimpleIconsBuildTasksExecutablePath)'==''"
               Text="SimpleIconsBuildTasksExecutablePath was not resolved. MSBuildThisFileDirectory=$(MSBuildThisFileDirectory)" />
        <Error Condition="!Exists('$(SimpleIconsBuildTasksExecutablePath)')"
               Text="Simple Icons native BuildTasks executable not found at '$(SimpleIconsBuildTasksExecutablePath)'." />

        <!-- NuGet extraction does not preserve Unix execute permissions. -->
        <Exec Condition="'$(OS)' != 'Windows_NT'" Command="chmod +x &quot;$(SimpleIconsBuildTasksExecutablePath)&quot;" />
        <Exec WorkingDirectory="$(_SimpleIconsProjectDir)"
              IgnoreExitCode="false"
              ConsoleToMSBuild="true"
              StandardOutputImportance="high"
              StandardErrorImportance="high"
              Command='&quot;$(SimpleIconsBuildTasksExecutablePath)&quot; --projectDir &quot;$(_SimpleIconsProjectDir)&quot;$(_SimpleIconsOutputArg)$(_SimpleIconsResourcesArg)' />
        <Touch Files="$(_SimpleIconsSuccessStamp)" AlwaysCreate="true" />
    </Target>

    <Target Name="IncludeGeneratedSimpleIconsSources"
            BeforeTargets="XamlPreCompile;BeforeCompile;CoreCompile"
            DependsOnTargets="RunSimpleIconsGeneratorBuildTasks"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true' and '$(SimpleIconsGeneratorBuildEnabled)'=='true'">
        <ItemGroup Condition="Exists('$(SimpleIconsSvgMapOutput)')">
            <Compile Remove="$(SimpleIconsSvgMapOutput)" />
            <Compile Include="$(SimpleIconsSvgMapOutput)" />
        </ItemGroup>

        <ItemGroup Condition="'$(SimpleIconsIncludeSvgProvider)'=='true' and Exists('$(SimpleIconsSvgProviderOutput)')">
            <Compile Remove="$(SimpleIconsSvgProviderOutput)" />
            <Compile Include="$(SimpleIconsSvgProviderOutput)" />
        </ItemGroup>

        <ItemGroup Condition="'$(SimpleIconsIncludeServiceCollectionExtensions)'=='true' and Exists('$(SimpleIconsServiceCollectionExtensionsOutput)')">
            <Compile Remove="$(SimpleIconsServiceCollectionExtensionsOutput)" />
            <Compile Include="$(SimpleIconsServiceCollectionExtensionsOutput)" />
        </ItemGroup>
    </Target>

    <Target Name="IncludeGeneratedSimpleIconsSourcesDesignTime"
            BeforeTargets="XamlPreCompile;BeforeCompile;CoreCompile"
            Condition="'$(DesignTimeBuild)'=='true' and '$(IsCrossTargetingBuild)'!='true' and '$(SimpleIconsGeneratorBuildEnabled)'=='true'">
        <ItemGroup Condition="Exists('$(SimpleIconsSvgMapOutput)')">
            <Compile Remove="$(SimpleIconsSvgMapOutput)" />
            <Compile Include="$(SimpleIconsSvgMapOutput)" />
        </ItemGroup>

        <ItemGroup Condition="'$(SimpleIconsIncludeSvgProvider)'=='true' and Exists('$(SimpleIconsSvgProviderOutput)')">
            <Compile Remove="$(SimpleIconsSvgProviderOutput)" />
            <Compile Include="$(SimpleIconsSvgProviderOutput)" />
        </ItemGroup>

        <ItemGroup Condition="'$(SimpleIconsIncludeServiceCollectionExtensions)'=='true' and Exists('$(SimpleIconsServiceCollectionExtensionsOutput)')">
            <Compile Remove="$(SimpleIconsServiceCollectionExtensionsOutput)" />
            <Compile Include="$(SimpleIconsServiceCollectionExtensionsOutput)" />
        </ItemGroup>
    </Target>
</Project>
